---
source: crates/proef-cli/tests/corpus.rs
expression: "String::from_utf8(content_a).unwrap()"
---
# proef artifact — A photo uploaded via the API appears in the photo feed
# source: tests/features/502_api_photo.feature:10
# replay: hurl --test 502-api-photo--a-photo-uploaded-via-the-api-appears-in-the-photo-feed.hurl --variables-file 502-api-photo--a-photo-uploaded-via-the-api-appears-in-the-photo-feed.vars

# tests/features/502_api_photo.feature:11 — the client environment is provisioned (fixture warm-up probe)
# optional
GET http://127.0.0.1:8787/health
HTTP 200

# tests/features/502_api_photo.feature:11 — the client environment is provisioned (provision the environment)
POST http://127.0.0.1:8787/api/v1/env/provision
Authorization: Bearer {{apiToken}}
{"run": "proef-snapshot"}
HTTP 201
[Captures]
envId: jsonpath "$.id"

# tests/features/502_api_photo.feature:12 — the client feed is activated and ready (request activation)
POST http://127.0.0.1:8787/api/v1/feed/activate
X-Proef-Env: {{envId}}
Authorization: Bearer {{apiToken}}
{"env": "{{envId}}"}
HTTP 200
[Captures]
feedId: jsonpath "$.feedId"

# tests/features/502_api_photo.feature:12 — the client feed is activated and ready (feed reports ready)
GET http://127.0.0.1:8787/api/v1/feed/{{feedId}}/state
X-Proef-Env: {{envId}}
[Options]
retry: 10
retry-interval: 300ms
HTTP 200
[Asserts]
jsonpath "$.status" == "ready"

# tests/features/502_api_photo.feature:13 — the client Bakker-${run:id} is resolved (search clients for Bakker-proef-snapshot)
GET http://127.0.0.1:8787/api/v1/admin/search/clients
Authorization: Bearer {{apiToken}}
[Query]
q: Bakker-proef-snapshot
HTTP 200
[Captures]
clientId: jsonpath "$[0].id"

# tests/features/502_api_photo.feature:13 — the client Bakker-${run:id} is resolved (confirm the client exists)
GET http://127.0.0.1:8787/api/v1/clients/{{clientId}}
Authorization: Bearer {{apiToken}}
HTTP 200
[Asserts]
jsonpath "$.id" == "{{clientId}}"

# tests/features/502_api_photo.feature:14 — the relative uploads a photo (upload the photo)
POST http://127.0.0.1:8787/api/v1/clients/{{clientId}}/photos
X-Proef-Env: {{envId}}
Authorization: Bearer {{apiToken}}
{"source": "fixture.jpg", "run": "proef-snapshot"}
HTTP 201
[Captures]
photoId: jsonpath "$.id"

# tests/features/502_api_photo.feature:15 — the backend dispatches a push notification (push visible in queue)
GET http://127.0.0.1:8787/api/v1/push/queue
X-Proef-Env: {{envId}}
Authorization: Bearer {{apiToken}}
[Options]
retry: 10
retry-interval: 300ms
HTTP 200
[Asserts]
jsonpath "$.items" count > 0

# tests/features/502_api_photo.feature:16 — the client photo feed shows the photo (photo visible in the feed)
GET http://127.0.0.1:8787/api/v1/feed/{{feedId}}/photos
X-Proef-Env: {{envId}}
[Options]
retry: 10
retry-interval: 300ms
HTTP 200
[Asserts]
jsonpath "$.photos[0].id" == "{{photoId}}"
