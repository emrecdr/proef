<ol class="steps">
<li class="fail"><span class="glyph">✗</span> the guest logs in<span class="meta">:4 · 2× · 120ms</span><span class="track"><span class="bar fail" style="margin-left:0.0%;width:100.0%"></span></span><pre class="detail">assert failure: expected HTTP 401 but was 200
  at 502-login--login-rejects-a-bad-password.hurl:9</pre><pre class="detail">reproduce: curl the-guest-logs-in</pre></li>
</ol>
</details>
<script>
for (const b of document.querySelectorAll('.filter button')) {
  b.addEventListener('click', () => {
    for (const o of document.querySelectorAll('.filter button')) o.classList.remove('on');
    b.classList.add('on');
    const f = b.dataset.f;
    for (const d of document.querySelectorAll('details.scenario'))
      d.classList.toggle('gone', f !== 'all' && !d.classList.contains(f));
  });
}
</script>
</body>
</html>
