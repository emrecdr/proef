# Rust
/target

# proef runtime outputs (proef.toml is project config — commit it)
.proef-runs/
.proef-state.json

# encrypted secret store (ciphertext-only, but keep it out of history)
.proef-secrets.json
.proef-secrets.json.lock
.proef-secrets.json.*.tmp
.proef-secrets.json.corrupt

# cargo-fuzz outputs
fuzz/target/
fuzz/corpus/
fuzz/artifacts/
fuzz/coverage/

# macOS
.DS_Store

# devt workflow state (recursive — catches sub-tree devt invocations)
**/.devt/state/

# mdBook output (the Pages workflow builds it; book.toml at the root)
/book
