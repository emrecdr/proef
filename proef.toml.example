# proef project configuration — example (see docs/CONFIG.md, ADR-0012)
#
# Copy to `proef.toml` and adjust. Precedence (low → high):
#   built-in defaults < proef.toml base tables < active [env.<name>] < CLI flags
#
# Two kinds of thing live here: runner config ([run], [http], [sla]) and suite
# variables ([url], [vars]) — plus per-environment overrides ([env.<name>]).
# Secrets NEVER live here (use `proef secret set` / PROEF_SECRET_<NAME>).

# ── runner config ───────────────────────────────────────────────
[run]
# Default suite path — with this set, `proef test` needs no path argument.
# Unset falls back to the `tests/` convention. An explicit path always wins.
# suite = "tests"

# Root holding the hurl files a pack may `ref:` (ADR-0018), scanned recursively.
# Those files stay valid hurl — the `# @proef <name>` annotation is a comment — so
# the same file runs under `hurl` and under proef, and a corpus you already own is
# annotated once instead of transcribed. Relative paths resolve against this file's
# directory, so the root may sit outside the suite (even outside the repo).
# Unset means no fragments; there is no convention fallback.
# fragments = "tests/hurl"

# Parallel scenario workers. Default: available parallelism, capped by scenario count.
# jobs = 4

# Where per-run records and artifacts are written. Default: .proef-runs/
# runs-dir = ".proef-runs"

# Suite setup/teardown: a feature run once before/after the pool (ADR-0014).
# Setup's `saveAs: global` reaches every scenario (seed fixtures / shared state);
# a setup failure aborts the run, a teardown failure is a distinct exit 3.
# setup    = "tests/setup.feature"
# teardown = "tests/teardown.feature"

# Scenarios that cannot share the pool: a tag expression (the language `--tags`
# takes) selecting scenarios that run alone. For a scenario asserting absolute
# positions against a store no concurrent scenario may write to. This is
# exclusion, not ordering — a scenario that must run *before* the rest belongs
# in `setup` above.
# exclusive-tags = "@serial"

[http]
# Batch-level defaults for the hurl engine; per-entry [Options] in packs override.
# timeout-ms = 30000
# follow-location = false

[sla]
# Opt-in run-level latency budget (omit the table for no gate). A breach fails
# the run with exit 1 — never a new exit code, never masking a user/system fault.
# Distinct from hurl's per-request `duration < <ms>` assert (this is aggregate).
# p95-ms = 250    # 95th-percentile per-step duration ceiling
# max-ms = 1000   # slowest single-step ceiling

# ── suite variables (referenced in packs as ${url:key} / ${vars:key}) ──
[url]
# base = "http://127.0.0.1:8787"
# Name each endpoint and reference it as ${url:<name>} — packs hold no raw paths.
# Values compose from base (config resolves ${…} recursively); hurl run-time
# {{…}} path params pass through untouched:
# health = "${url:base}/health"
# record = "${url:base}/api/v1/records/{{recordId}}"

[vars]
# apiVersion = "v1"
# username   = "dev@example.com"

# ── per-environment overrides (select with --env <name> or PROEF_ENV) ──
# Each [env.<name>.<section>] mirrors a base table and deep-merges over it,
# key by key — list only what changes; everything else inherits the base.
# [env.staging.url]
# base = "https://staging.example.com"

# [env.prod.url]
# base = "https://api.example.com"
# [env.prod.http]
# timeout-ms = 60000
